#!/bin/sh
# Builds the GeoZL core and OpenZL with their own CMake files into src/build,
# then writes src/Makevars to link the static libraries into the package.
set -eu

: "${R_HOME:=$(R RHOME)}"
R_BIN="${R_HOME}/bin/R"

# The repository around the package when it is installed from a checkout, so
# a stale copy is never built, or else the copy the source package carries.
# Paths stay relative to src/, where make runs, so a directory with spaces in
# its name still works.
if [ -f ../../core/CMakeLists.txt ] && [ -f ../../extern/openzl/CMakeLists.txt ]; then
    CORE=../../../core
    OPENZL=../../../extern/openzl
elif [ -f src/ext/core/CMakeLists.txt ]; then
    CORE=ext/core
    OPENZL=ext/openzl
else
    echo "configure: no GeoZL sources; run tools/sync_r_vendor.py in the GeoZL repository" >&2
    exit 1
fi

CMAKE=${CMAKE:-}
if [ -n "$CMAKE" ]; then
    if ! "$CMAKE" --version >/dev/null 2>&1; then
        echo "configure: CMAKE=$CMAKE does not run" >&2
        exit 1
    fi
else
    for candidate in cmake /usr/bin/cmake /usr/local/bin/cmake \
        /opt/homebrew/bin/cmake /Applications/CMake.app/Contents/bin/cmake; do
        if command -v "$candidate" >/dev/null 2>&1 \
            && "$candidate" --version >/dev/null 2>&1; then
            CMAKE=$candidate
            break
        fi
    done
fi
if [ -z "$CMAKE" ]; then
    echo "configure: cmake 3.21 or newer is required" >&2
    exit 1
fi

# R's compilers may carry flags after the program, such as -arch on macOS.
program() { set -- $1; printf '%s' "$1"; }
flags() { set -- $1; shift; printf '%s' "$*"; }
deployment_target() {
    set -- $1
    while [ "$#" -gt 0 ]; do
        case $1 in
            -mmacosx-version-min=*) printf '%s' "${1#*=}"; return ;;
            -mmacosx-version-min) [ "$#" -gt 1 ] && printf '%s' "$2"; return ;;
        esac
        shift
    done
}
CC_LINE=$("$R_BIN" CMD config CC)
CXX_LINE=$("$R_BIN" CMD config CXX)
R_CFLAGS=$("$R_BIN" CMD config CFLAGS)
R_CXXFLAGS=$("$R_BIN" CMD config CXXFLAGS)
R_CPPFLAGS=$("$R_BIN" CMD config CPPFLAGS)
R_LDFLAGS=$("$R_BIN" CMD config LDFLAGS)

OSX_TARGET=${MACOSX_DEPLOYMENT_TARGET:-}
if [ -z "$OSX_TARGET" ] && [ "$(uname -s)" = Darwin ]; then
    OSX_TARGET=$(deployment_target "$CC_LINE $R_CFLAGS $R_CPPFLAGS $R_LDFLAGS")
fi
if [ -z "$OSX_TARGET" ] && [ "$(uname -s)" = Darwin ] && command -v otool >/dev/null 2>&1; then
    OSX_TARGET=$(otool -l "$R_HOME/bin/exec/R" 2>/dev/null | awk '
        /LC_BUILD_VERSION|LC_VERSION_MIN_MACOSX/ { found = 1 }
        found && ($1 == "minos" || $1 == "version") { print $2; exit }
    ')
fi
OSX_FLAG=${OSX_TARGET:+-mmacosx-version-min=$OSX_TARGET}

JOBS=${GEOZL_BUILD_JOBS:-2}
GENERATOR=${GEOZL_CMAKE_GENERATOR:-}

cd src
"$CMAKE" -S "$CORE" -B build ${GENERATOR:+-G "$GENERATOR"} \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_C_COMPILER="$(program "$CC_LINE")" \
    -DCMAKE_C_FLAGS="$(flags "$CC_LINE") $R_CPPFLAGS $R_CFLAGS $OSX_FLAG" \
    -DCMAKE_CXX_COMPILER="$(program "$CXX_LINE")" \
    -DCMAKE_CXX_FLAGS="$(flags "$CXX_LINE") $R_CPPFLAGS $R_CXXFLAGS $OSX_FLAG" \
    -DCMAKE_EXE_LINKER_FLAGS="$R_LDFLAGS" \
    -DCMAKE_SHARED_LINKER_FLAGS="$R_LDFLAGS" \
    -DCMAKE_MODULE_LINKER_FLAGS="$R_LDFLAGS" \
    ${OSX_TARGET:+-DCMAKE_OSX_DEPLOYMENT_TARGET="$OSX_TARGET"} \
    -DBUILD_SHARED_LIBS=OFF \
    -DGEOZL_BUILD_KERNELS_SHARED=OFF \
    -DGEOZL_OPENZL_DIR="$(cd "$OPENZL" && pwd)"
"$CMAKE" --build build --target geozl --parallel "$JOBS"

# Keep the four archives and the generated config header, and drop the CMake
# tree: R refuses a package that carries its Makefiles and object paths.
rm -rf lib gen
mkdir -p lib gen/openzl
cp build/libgeozl.a build/openzl/libopenzl.a \
    build/openzl/zstd_build/lib/libzstd.a build/openzl/lz4_build/liblz4.a lib/
cp build/openzl/include/openzl/zl_config.h gen/openzl/
rm -rf build

THREAD_LIBS=${GEOZL_THREAD_LIBS--pthread}
sed -e "s|@CORE@|$CORE|g" -e "s|@OPENZL@|$OPENZL|g" \
    -e "s|@THREAD_LIBS@|$THREAD_LIBS|g" -e "s|@OSX_FLAG@|$OSX_FLAG|g" \
    Makevars.in > Makevars
