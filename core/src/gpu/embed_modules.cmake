# Writes OUTPUT, a C file holding every MODULE_DIR/*.EXTENSION as bytes, so the
# library carries its kernels and needs no Slang at build or run time.
file(GLOB modules "${MODULE_DIR}/*.${EXTENSION}")
string(REPEAT "0x..," 16 row)
list(SORT modules)
set(body "// Generated by embed_modules.cmake from core/src/gpu/modules.\n")
string(APPEND body "#include \"gpu/modules.h\"\n\n")
set(table "")
foreach(module IN LISTS modules)
    get_filename_component(name "${module}" NAME_WE)
    file(READ "${module}" hex HEX)
    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")
    string(REGEX REPLACE "(${row})" "\\1\n  " bytes "${bytes}")
    string(APPEND body "static const unsigned char ${name}[] = {\n  ${bytes}};\n\n")
    string(APPEND table "    {\"${name}\", ${name}, sizeof(${name})},\n")
endforeach()
list(LENGTH modules count)
string(APPEND body "const GeozlGpuModule geozl_gpu_modules[] = {\n${table}};\n")
string(APPEND body "const size_t geozl_gpu_module_count = ${count};\n")
file(WRITE "${OUTPUT}.tmp" "${body}")
configure_file("${OUTPUT}.tmp" "${OUTPUT}" COPYONLY)
file(REMOVE "${OUTPUT}.tmp")
