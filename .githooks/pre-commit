#!/usr/bin/env bash
set -euo pipefail

git diff --cached --quiet -- VERSION && exit 0

version=$(git show :VERSION | tr -d '[:space:]')

if [[ -z $version ]]; then
    echo "VERSION is empty" >&2
    exit 1
fi

# X.Y.Z with an optional suffix, the ones tools/sync_r_vendor.py can map.
if ! [[ $version =~ ^[0-9]+\.[0-9]+\.[0-9]+(-(alpha|beta|rc)\.[0-9]+)?$ ]]; then
    echo "VERSION '$version' is not X.Y.Z[-alpha.N|-beta.N|-rc.N]" >&2
    exit 1
fi
